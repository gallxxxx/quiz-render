# Что не уезжает на сборочную машину.

# Библиотеки — ставятся там заново по package-lock.json
node_modules/

# Рабочий мусор и готовые файлы
out/
*.log

# Клипы и фотографии текущего выпуска: качаются заново под каждый ролик,
# и это 70 мегабайт, которые незачем возить туда-сюда.
public/*.mp4
public/*.jpg
public/*.jpeg
public/*.png

# Озвучка — синтезируется на месте, бесплатно и без ключей
public/voice/

# Память о том, что уже брали: у сборочной машины она своя и не нужна
public/_уже брали*.txt

# Одноразовые скрипты прошлых разборов — история, а не рабочий код
_*.mjs
_fetch-state.json

# Ключи — на всякий случай, хотя они лежат этажом выше
ключ*.txt
